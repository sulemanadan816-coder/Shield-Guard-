{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "ShieldGuard",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ShieldGuard"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["gesture-client.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["overlay-filter.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads_rules", "enabled": true, "path": "rules/ads.json" },
      { "id": "trackers_rules", "enabled": true, "path": "rules/trackers.json" },
      { "id": "popups_rules", "enabled": true, "path": "rules/popups.json" },
      { "id": "redirects_rules", "enabled": true, "path": "rules/redirects.json" },
      { "id": "security_rules", "enabled": true, "path": "rules/security.json" }
    ]
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "declarativeNetRequest",
    "alarms",
    "notifications"
  ],
  "minimum_chrome_version": "111"
}
