{
  "name": "shieldguard",
  "version": "0.1.0",
  "description": "ShieldGuard - Advanced Popup, Redirect, Ad & Browsing Protection Extension (Manifest V3)",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:js": "node scripts/build.mjs",
    "build:static": "node scripts/copy-static.mjs",
    "build": "npm run typecheck && npm run build:js && npm run build:static",
    "clean": "rm -rf dist",
    "build:android-assets": "node scripts/build-android-assets.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^26.2.0",
    "esbuild": "^0.23.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
